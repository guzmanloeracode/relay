# Copy to .env for `docker compose up`. In production keep this file outside the repository
# (for example /etc/relay/relay.env, readable by root only) and pass it with --env-file.

# --- Required ---
POSTGRES_PASSWORD=change-me
REDIS_PASSWORD=change-me-too
# 32 random bytes in base64; encrypts webhook signing secrets at rest. Keep it: changing it makes stored secrets
# unreadable. Generate one with: openssl rand -base64 32
RELAY_SECRET_KEY=

# --- Service ---
RELAY_PUBLIC_URL=http://localhost:8080
# Host port of the API (bound to 127.0.0.1).
RELAY_PORT=8080
# debug, info, warn or error.
LOG_LEVEL=info
# Attempts in flight per worker process.
WORKER_CONCURRENCY=64
# PostgreSQL connections per API process and per worker process (keep their sum under max_connections, 80).
API_DB_CONNS=16
WORKER_DB_CONNS=24
# Events, deliveries and attempts are deleted after this.
RETENTION=720h
# Allow webhook URLs on loopback or private networks. Keep false on a public instance (SSRF protection).
ALLOW_PRIVATE_NETWORKS=false

# --- Retries (defaults shown) ---
# Attempts per delivery before the dead-letter queue.
# RETRY_MAX_ATTEMPTS=8
# First wait; each next one is 3x longer, with jitter (8 attempts span up to about 23 hours).
# RETRY_BASE=75s
# RETRY_MAX_DELAY=16h
# WEBHOOK_TIMEOUT=10s
# Disable an endpoint after this many failed attempts in a row that span at least ENDPOINT_DISABLE_MIN_AGE.
# ENDPOINT_DISABLE_AFTER=10
# ENDPOINT_DISABLE_MIN_AGE=24h
# How long the old secret keeps signing after a rotation.
# SECRET_ROTATION_GRACE=24h

# --- Email: log (send nothing, log it), resend or smtp ---
EMAIL_PROVIDER=log
EMAIL_FROM=Relay <relay@example.com>
RESEND_API_KEY=
# smtp://user:pass@host:587 (STARTTLS) or smtps://user:pass@host:465
SMTP_URL=

# --- Push (Expo): only if your Expo project requires access tokens ---
EXPO_ACCESS_TOKEN=

# --- Tracing: an OTLP/HTTP endpoint, such as http://jaeger:4318 with the observability profile ---
OTEL_EXPORTER_OTLP_ENDPOINT=
